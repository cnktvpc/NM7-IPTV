<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@color/navy">
    <ImageView android:layout_width="match_parent" android:layout_height="38dp"
        android:src="@drawable/nm7_main_logo" android:scaleType="centerInside"
        android:adjustViewBounds="true" android:contentDescription="Logo Phuongnm7 TV" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="2dp" android:layout_marginBottom="3dp" android:gravity="center_vertical">
        <EditText android:id="@+id/inputSearch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:inputType="text" android:singleLine="true" android:importantForAutofill="no" android:hint="Tìm kênh, nhóm hoặc URL…" android:textSize="14sp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:backgroundTint="@color/accent" />
        <Button android:id="@+id/btnClearFilters" android:layout_width="64dp" android:layout_height="42dp" android:layout_marginStart="5dp" android:background="@drawable/button_secondary" android:text="Bỏ lọc" android:textSize="11sp" android:textAllCaps="false" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btnReloadPlaylist" android:layout_width="84dp" android:layout_height="42dp" android:layout_marginStart="5dp" android:background="@drawable/button_secondary" android:text="↻ Tải lại" android:textSize="11sp" android:textAllCaps="false" android:textColor="@color/text_primary" android:contentDescription="Tải lại playlist" />
        <Button android:id="@+id/btnWallpaper" android:layout_width="92dp" android:layout_height="42dp" android:layout_marginStart="5dp" android:background="@drawable/button_secondary" android:text="⚙ Tùy chọn" android:contentDescription="Tùy chọn ứng dụng" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/text_primary" android:focusableInTouchMode="true" />
    </LinearLayout>
    <ScrollView android:id="@+id/importPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false" android:background="@drawable/panel">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" android:orientation="vertical">
            <EditText android:id="@+id/inputUrl" android:layout_width="match_parent" android:layout_height="48dp" android:inputType="textUri" android:singleLine="true" android:importantForAutofill="no" android:hint="@string/playlist_url_hint" android:textSize="14sp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:backgroundTint="@color/accent" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp">
                <Button android:id="@+id/btnLoadUrl" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:background="@drawable/button_primary" android:text="@string/load_url" android:textAllCaps="false" android:textColor="@color/navy" />
                <Button android:id="@+id/btnOpenFile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="4dp" android:background="@drawable/button_secondary" android:text="@string/open_file" android:textAllCaps="false" android:textColor="@color/text_primary" />
            </LinearLayout>
            <Button android:id="@+id/btnPlayUrl" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:background="@drawable/button_secondary" android:text="▶ Phát URL trực tiếp" android:textAllCaps="false" android:textColor="@color/accent" />
        </LinearLayout>
    </ScrollView>
    <HorizontalScrollView android:id="@+id/groupScroller" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="2dp" android:fillViewport="false" android:scrollbars="none">
        <LinearLayout android:id="@+id/groupRow" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
    </HorizontalScrollView>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:indeterminateTint="@color/accent" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/listChannels" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="3dp" android:listSelector="@drawable/list_focus" android:focusable="true" android:focusableInTouchMode="false" />
        <TextView android:id="@+id/txtEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="20dp" android:text="Chưa có kênh phù hợp.
Mở nguồn hoặc bấm Bỏ lọc." android:textColor="@color/text_secondary" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>