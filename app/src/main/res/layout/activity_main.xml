<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mainRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="0dp" android:background="@color/navy">
    <ImageView android:id="@+id/headerLogo" android:layout_width="match_parent" android:layout_height="68dp"
        android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:paddingHorizontal="12dp"
        android:src="@drawable/nm7_main_logo" android:scaleType="centerInside"
        android:adjustViewBounds="true" android:contentDescription="Logo Phuongnm7 TV" />

    <LinearLayout android:id="@+id/iptvPanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginBottom="5dp">
        <Button android:id="@+id/btnAllChannels" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/button_primary" android:text="Tất cả" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/navy" />
        <Button android:id="@+id/btnFavorites" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginHorizontal="6dp" android:background="@drawable/button_secondary" android:text="★ Yêu thích" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btnReloadUrl" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/button_secondary" android:text="↻ Tải lại" android:textSize="11sp" android:textAllCaps="false" android:textColor="@color/accent" />
        <Button android:id="@+id/btnRecent" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/button_secondary" android:text="◷ Gần đây" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/text_primary" />
        <Button android:id="@+id/btnWallpaper" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/button_secondary" android:text="⚙ Tùy chọn" android:contentDescription="Tùy chọn ứng dụng" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/text_primary" />
    </LinearLayout>
    <ScrollView android:id="@+id/importPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/panel">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" android:orientation="vertical">
            <EditText android:id="@+id/inputUrl" android:layout_width="match_parent" android:layout_height="48dp" android:inputType="textUri" android:singleLine="true" android:importantForAutofill="no" android:hint="@string/playlist_url_hint" android:textSize="14sp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:backgroundTint="@color/accent" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp">
                <Button android:id="@+id/btnLoadUrl" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/button_primary" android:text="@string/load_url" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/navy" />
                <Button android:id="@+id/btnOpenFile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/button_secondary" android:text="@string/open_file" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/text_primary" />
            </LinearLayout>
            <Button android:id="@+id/btnPlayUrl" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:background="@drawable/button_secondary" android:text="▶ Phát URL trực tiếp" android:textAllCaps="false" android:textColor="@color/accent" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp">
        <EditText android:id="@+id/inputSearch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:singleLine="true" android:hint="Tìm kênh, nhóm hoặc URL…" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:backgroundTint="@color/accent" />
        <Button android:id="@+id/btnClearFilters" android:layout_width="68dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:background="@drawable/button_secondary" android:text="Bỏ lọc" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/text_primary" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="50dp" android:scrollbars="none"><LinearLayout android:id="@+id/groupRow" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" /></HorizontalScrollView>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/listChannels" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="5dp" android:listSelector="@drawable/list_focus" />
        <TextView android:id="@+id/txtEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="20dp" android:text="Chưa có kênh phù hợp." android:textColor="@color/text_secondary" android:visibility="gone" />
    </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/youtubePanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="@android:color/white" android:visibility="gone">
        <WebView android:id="@+id/youtubeWebView" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/white" android:overScrollMode="never" />
    </LinearLayout>
    <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false" android:background="#17151B">
        <LinearLayout android:id="@+id/btnTabYoutube" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="2dp" android:clickable="true" android:focusable="true" android:contentDescription="Tab YouTube">
            <TextView android:id="@+id/txtTabYoutubeIcon" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center" android:text="▶" android:textSize="25sp" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/txtTabYoutubeLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="YouTube" android:textSize="12sp" android:textColor="@color/text_secondary" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnTabIptv" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="2dp" android:clickable="true" android:focusable="true" android:contentDescription="Tab IPTV">
            <TextView android:id="@+id/txtTabIptvIcon" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center" android:text="▣" android:textSize="25sp" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/txtTabIptvLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="IPTV" android:textSize="12sp" android:textColor="@color/text_secondary" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnTabOptions" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="2dp" android:clickable="true" android:focusable="true" android:contentDescription="Tùy chọn">
            <TextView android:id="@+id/txtTabOptionsIcon" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center" android:text="⚙︎" android:textSize="25sp" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/txtTabOptionsLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Tùy chọn" android:textSize="12sp" android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>