<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:show_subtitle_button="true"
        app:use_controller="true" />
    <LinearLayout
        android:id="@+id/playerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#C007111F"
        android:orientation="vertical"
        android:padding="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnBack"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="@drawable/button_secondary"
                android:text="‹"
                android:contentDescription="Quay lại danh sách"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/txtPlayerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnRotate"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/button_secondary"
                android:text="↻"
                android:contentDescription="Xoay màn hình"
                android:textColor="@color/accent" />
            <Button
                android:id="@+id/btnFormat"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_secondary"
                android:text="Định dạng"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />
            <Button
                android:id="@+id/btnQuality"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/button_secondary"
                android:text="Chất lượng"
                android:textAllCaps="false"
                android:textColor="@color/accent" />
        </LinearLayout>
        <TextView
            android:id="@+id/txtPlayerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="5dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="#AFC2D5"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/txtPlayerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đang kết nối…"
            android:textColor="@color/accent"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtFps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FPS: đang đo…"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btnResize"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/button_secondary"
                android:text="Khung hình"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />
            <Button
                android:id="@+id/btnLiveServer"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/button_secondary"
                android:text="Server"
                android:textAllCaps="false"
                android:textColor="@color/live_accent"
                android:visibility="gone" />
            <Button
                android:id="@+id/btnDrm"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/button_secondary"
                android:text="DRM"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/playerError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="48dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/panel"
        android:padding="16dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/txtPlayerError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/warning"
            android:textSize="14sp" />
        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_primary"
            android:text="Thử lại"
            android:textAllCaps="false"
            android:textColor="@color/navy" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/quickChannelPanel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F207111F"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Danh sách kênh" android:textColor="@color/text_primary"
            android:textSize="21sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="Chọn kênh • Back để đóng"
            android:textColor="@color/text_secondary" android:textSize="11sp" />
        <HorizontalScrollView android:id="@+id/quickGroupScroller" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="8dp" android:scrollbars="none" android:fillViewport="false"
            android:fadingEdge="none" android:overScrollMode="never" android:smoothScrollbar="true">
            <LinearLayout android:id="@+id/quickGroupRow" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <ListView android:id="@+id/quickChannelList" android:layout_width="match_parent"
                android:layout_height="match_parent" android:divider="@android:color/transparent"
                android:dividerHeight="6dp" android:focusable="true"
                android:focusableInTouchMode="false" android:listSelector="@drawable/list_focus" />
            <TextView android:id="@+id/txtQuickEmpty" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center"
                android:text="Chưa tải được danh sách kênh" android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
