<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/live_event_card"
    android:gravity="center_vertical"
    android:minHeight="86dp"
    android:orientation="horizontal"
    android:padding="9dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/txtChannelBadge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/channel_badge"
            android:gravity="center"
            android:text="LIVE"
            android:textColor="@color/live_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgChannelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Logo sự kiện"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtLiveEventTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/live_badge"
                android:gravity="center"
                android:minWidth="42dp"
                android:paddingHorizontal="7dp"
                android:text="LIVE"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtLiveGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnLiveServers"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:text="1 Server"
            android:textColor="@color/live_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnLiveFavorite"
        android:layout_width="38dp"
        android:layout_height="48dp"
        android:contentDescription="Thêm hoặc bỏ sự kiện yêu thích"
        android:focusable="false"
        android:gravity="center"
        android:text="♡"
        android:textColor="@color/live_accent"
        android:textSize="25sp" />
</LinearLayout>
