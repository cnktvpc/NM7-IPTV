<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="1dp"
    android:background="@drawable/live_event_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="74dp"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp"
    android:paddingVertical="3dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/txtChannelBadge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/channel_badge"
            android:gravity="center"
            android:text="LIVE"
            android:textColor="@color/live_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgChannelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Logo sự kiện"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtLiveEventTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/live_badge"
                android:gravity="center"
                android:minWidth="38dp"
                android:paddingHorizontal="6dp"
                android:text="LIVE"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtLiveGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnLiveServers"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="100dp"
                android:paddingHorizontal="10dp"
                android:text="Chọn server · 2 ▾"
                android:textColor="@color/live_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLiveDuration"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Đã live 0 phút"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnLiveFavorite"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:contentDescription="Thêm hoặc bỏ sự kiện yêu thích"
        android:focusable="false"
        android:gravity="center"
        android:text="♡"
        android:textColor="@color/live_accent"
        android:textSize="22sp" />
</LinearLayout>
